{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["extensions/**/*.ts", "extensions/**/*.mts"]
}
